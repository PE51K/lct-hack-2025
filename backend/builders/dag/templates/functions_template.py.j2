def load_to_postgres(data: List[Dict]):
    """Load data to PostgreSQL."""
    import psycopg2
    from psycopg2.extras import execute_batch
    from urllib.parse import urlparse

    logger.info("📤 Загрузка в PostgreSQL")

    # DEBUG: Print full connection string (TEMPORARY - REMOVE IN PRODUCTION)
    logger.info("=" * 80)
    logger.info("🔍 DEBUG: POSTGRESQL LOAD CREDENTIALS")
    logger.info(f"Target Connection String: {TARGET_CONNECTION}")
    logger.info(f"Target Database: {TARGET_DATABASE}")
    logger.info(f"Target Schema: {TARGET_SCHEMA}")
    logger.info(f"Target Table: {TARGET_TABLE}")
    logger.info(f"Load Strategy: {LOAD_STRATEGY}")
    logger.info("=" * 80)

    # Parse connection string to extract credentials
    parsed = urlparse(TARGET_CONNECTION)
    username = parsed.username
    password = parsed.password
    hostname = parsed.hostname
    port = parsed.port or 5432
    database = parsed.path.lstrip('/')

    # Step 1: Connect to default 'postgres' database to create user and target database
    logger.info("🔧 Подключение к postgres для создания пользователя и БД...")
    admin_conn_string = f"postgresql://test_postgres:89651de2c28dd66507357d7d978fe46e26944e1efb255b470e6b10f5869a3f9a@{hostname}:{port}/test_postgres"

    try:
        admin_conn = psycopg2.connect(admin_conn_string)
        admin_conn.autocommit = True
        admin_cursor = admin_conn.cursor()

        # Create user if not exists, or update password if exists
        logger.info(f"Creating/updating user '{username}'...")
        admin_cursor.execute(f"""
            DO $$
            BEGIN
                IF NOT EXISTS (SELECT FROM pg_catalog.pg_user WHERE usename = '{username}') THEN
                    CREATE USER "{username}" WITH PASSWORD '{password}';
                    RAISE NOTICE 'User created: {username}';
                ELSE
                    ALTER USER "{username}" WITH PASSWORD '{password}';
                    RAISE NOTICE 'User password updated: {username}';
                END IF;
            END
            $$;
        """)

        # Create database if not exists
        logger.info(f"Creating database '{database}' if not exists...")
        admin_cursor.execute(f"SELECT 1 FROM pg_database WHERE datname = '{database}'")
        if not admin_cursor.fetchone():
            admin_cursor.execute(f'CREATE DATABASE "{database}" OWNER "{username}"')
            logger.info(f"✅ Database '{database}' created")
        else:
            logger.info(f"Database '{database}' already exists")
            # Grant privileges to existing database
            admin_cursor.execute(f'GRANT ALL PRIVILEGES ON DATABASE "{database}" TO "{username}"')

        admin_cursor.close()
        admin_conn.close()
        logger.info("✅ Пользователь и БД готовы")

    except Exception as e:
        logger.warning(f"Could not create user/database (may already exist): {e}")

    # Step 2: Connect to target database
    conn = psycopg2.connect(TARGET_CONNECTION)
    conn.autocommit = False
    cursor = conn.cursor()
    
    try:
        # Execute DDL if exists
        {% if ddl.statements %}
        logger.info("Выполнение DDL statements")
        ddl_statements = """{{ ddl.statements }}"""
        for statement in ddl_statements.split(';'):
            statement = statement.strip()
            if statement:
                logger.debug(f"Executing: {statement[:100]}...")
                cursor.execute(statement)
        conn.commit()
        logger.info("✅ DDL выполнен успешно")
        {% endif %}
        
        if not data:
            logger.warning("No data to load")
            return 0
        
        # Prepare table name
        table_name = f"{TARGET_SCHEMA}.{TARGET_TABLE}"
        logger.info(f"Target table: {table_name}")
        
        # Use target table columns from schema (not from data)
        columns = TARGET_TABLE_COLUMNS
        logger.info(f"Target columns (from schema): {columns}")
        
        # Check what columns are available in data
        data_columns = set(data[0].keys()) if data else set()
        logger.info(f"Available columns in data: {data_columns}")
        
        # Find missing columns
        missing_columns = set(columns) - data_columns
        
        # Try intelligent column mapping before adding NULLs
        column_mapping = {}
        if missing_columns:
            logger.info("🔍 Attempting intelligent column mapping...")
            
            for target_col in missing_columns:
                # Try to find similar source column
                target_lower = target_col.lower()
                
                # Strategy 1: Look for columns that end with the same name
                # e.g., "name" matches "employees_employee_name"
                for source_col in data_columns:
                    source_lower = source_col.lower()
                    if target_lower.endswith(source_lower) or source_lower.endswith(target_lower.split('_')[-1]):
                        column_mapping[target_col] = source_col
                        logger.info(f"  └─ Mapped '{source_col}' → '{target_col}'")
                        break
                    # Strategy 2: Look for partial matches
                    elif source_lower in target_lower or target_lower.split('_')[-1] in source_lower:
                        column_mapping[target_col] = source_col
                        logger.info(f"  └─ Mapped '{source_col}' → '{target_col}' (partial match)")
                        break
            
            # Apply mappings
            if column_mapping:
                logger.info(f"✅ Found {len(column_mapping)} automatic column mappings")
                for row in data:
                    for target_col, source_col in column_mapping.items():
                        if source_col in row:
                            row[target_col] = row[source_col]
                
                # Update missing columns list
                missing_columns = missing_columns - set(column_mapping.keys())
        
        # Add NULL for remaining missing columns
        if missing_columns:
            logger.warning(f"⚠️ Data missing target columns (filling with NULL): {missing_columns}")
            for row in data:
                for col in missing_columns:
                    row[col] = None
        
        # Remove extra columns that are not in target schema
        all_source_columns = set(data[0].keys()) if data else set()
        extra_columns = all_source_columns - set(columns)
        if extra_columns:
            logger.info(f"🔄 Removing {len(extra_columns)} extra columns not in target schema: {extra_columns}")
            for row in data:
                for col in list(row.keys()):
                    if col in extra_columns:
                        row.pop(col, None)
        
        # Execute load strategy
        if LOAD_STRATEGY == 'append':
            logger.info("Стратегия: APPEND")
            query = f"INSERT INTO {table_name} ({', '.join(columns)}) VALUES ({', '.join(['%s'] * len(columns))})"
            values = [[row.get(col) for col in columns] for row in data]
            execute_batch(cursor, query, values, page_size=1000)
            
        elif LOAD_STRATEGY == 'upsert':
            logger.info("Стратегия: UPSERT")
            # Get primary key columns
            primary_keys = [k for k in columns if k in PRIMARY_KEY_COLUMNS] if PRIMARY_KEY_COLUMNS else [columns[0]]
            update_cols = [col for col in columns if col not in primary_keys]
            
            query = f"""
                INSERT INTO {table_name} ({', '.join(columns)})
                VALUES ({', '.join(['%s'] * len(columns))})
                ON CONFLICT ({', '.join(primary_keys)})
                DO UPDATE SET {', '.join([f'{col} = EXCLUDED.{col}' for col in update_cols])}
            """
            values = [[row.get(col) for col in columns] for row in data]
            execute_batch(cursor, query, values, page_size=1000)
            
        elif LOAD_STRATEGY == 'full_refresh':
            logger.info("Стратегия: FULL_REFRESH")
            cursor.execute(f"TRUNCATE TABLE {table_name}")
            query = f"INSERT INTO {table_name} ({', '.join(columns)}) VALUES ({', '.join(['%s'] * len(columns))})"
            values = [[row.get(col) for col in columns] for row in data]
            execute_batch(cursor, query, values, page_size=1000)
            
        elif LOAD_STRATEGY == 'incremental':
            logger.info("Стратегия: INCREMENTAL")
            # Similar to append but with timestamp check
            query = f"INSERT INTO {table_name} ({', '.join(columns)}) VALUES ({', '.join(['%s'] * len(columns))})"
            values = [[row.get(col) for col in columns] for row in data]
            execute_batch(cursor, query, values, page_size=1000)
        
        conn.commit()
        loaded_count = len(data)
        logger.info(f"✅ Загружено записей: {loaded_count}")
        
        cursor.close()
        conn.close()
        
        return loaded_count
        
    except Exception as e:
        conn.rollback()
        logger.error(f"❌ Ошибка загрузки в PostgreSQL: {e}")
        cursor.close()
        conn.close()
        raise


