                    extracted_data.append(data)
        elif CONTENT_TYPE == 'xml':
            import xml.etree.ElementTree as ET
            tree = ET.parse(file_path)
            root = tree.getroot()
            
            # Flatten nested XML structure to match metamodel
            def flatten_element(element, parent_path=''):
                """Recursively flatten XML element to dict with nested paths."""
                result = {}
                
                # Process current element's text
                if element.text and element.text.strip():
                    # Only use parent_path if it's not empty, don't double-prefix
                    if parent_path:
                        result[parent_path.rstrip('_')] = element.text.strip()
                    else:
                        result[element.tag] = element.text.strip()
                
                # Process all child elements
                for child in element:
                    # Build path with underscore separator for nested elements
                    if parent_path:
                        child_path = f"{parent_path}{child.tag}_"
                    else:
                        child_path = f"{child.tag}_"
                    child_data = flatten_element(child, child_path)
                    result.update(child_data)
                
                return result
            
            # Parse each record (direct children of root)
            # Don't include root element name in column paths
            for child in root:
                row = flatten_element(child, '')
                if row:  # Only add non-empty records
                    extracted_data.append(row)
    
    logger.info(f"Файлов обработано: {files_processed}")
