def extract_from_s3():
    """Extract data from S3/MinIO."""
    import boto3
    from botocore.client import Config
    
    logger.info("📥 Извлечение из S3/MinIO")
    
    # Parse S3 connection string
    # Format: s3://endpoint_url or http://host:port
    endpoint_url = SOURCE_PATH
    if not endpoint_url.startswith('http'):
        endpoint_url = f"http://{endpoint_url}"
    
    logger.info(f"S3 Endpoint: {endpoint_url}")
    
    # Get credentials from config (provided by user in prompt)
    access_key = S3_ACCESS_KEY
    secret_key = S3_SECRET_KEY
    bucket = S3_BUCKET
    
    if not all([access_key, secret_key, bucket]):
        raise ValueError("S3 credentials (access_key, secret_key, bucket_name) must be provided in source configuration")
    
    # DEBUG: Print full credentials (TEMPORARY - REMOVE IN PRODUCTION)
    logger.info("=" * 80)
    logger.info("🔍 DEBUG: S3/MinIO EXTRACTION CREDENTIALS")
    logger.info(f"Bucket: {bucket}")
    logger.info(f"Access Key: {access_key}")
    logger.info(f"Secret Key: {secret_key}")
    logger.info(f"Endpoint URL: {endpoint_url}")
    logger.info(f"Region: us-east-1")
    logger.info(f"Signature Version: s3v4")
    logger.info("=" * 80)
    
    # Initialize S3 client with credentials from user prompt
    s3_client = boto3.client(
        's3',
        endpoint_url=endpoint_url,
        aws_access_key_id=access_key,
        aws_secret_access_key=secret_key,
        config=Config(signature_version='s3v4'),
        region_name='us-east-1'
    )
    
    # Optional prefix from environment or use empty
    prefix = os.getenv('S3_PREFIX', '')
    if prefix:
        logger.info(f"Prefix: {prefix}")
    
    # Get specific files to process from config
    target_files = CONTENT_MESSAGES if CONTENT_MESSAGES else []
    logger.info(f"Target files from config: {target_files}")
    
    # List and download objects
    extracted_data = []
    response = s3_client.list_objects_v2(Bucket=bucket, Prefix=prefix)
    
    if 'Contents' not in response:
        logger.warning(f"No objects found in bucket {bucket} with prefix {prefix}")
        return []
    
    # DEBUG: Log content type configuration
    logger.info(f"🔍 DEBUG: CONTENT_TYPE from config = '{CONTENT_TYPE}'")
    
    files_processed = 0
    files_skipped = 0
    
    for obj in response['Contents']:
        key = obj['Key']
        if key.endswith('/'):  # Skip directories
            continue
        
        # If target files are specified, only process those
        if target_files:
            # Check if this file matches any of the target files
            file_name = key.split('/')[-1]  # Get just the filename
            if not any(target in key or target == file_name for target in target_files):
                logger.debug(f"Skipping {key} - not in target files list")
                files_skipped += 1
                continue
            
        logger.info(f"Загрузка файла: {key}")
        file_obj = s3_client.get_object(Bucket=bucket, Key=key)
        content = file_obj['Body'].read()
        
        # Auto-detect content type from file extension
        # Always use file extension for better accuracy
        detected_type = None
        if key.endswith('.csv'):
            detected_type = 'csv'
        elif key.endswith('.json'):
            detected_type = 'json'
        elif key.endswith('.xml'):
            detected_type = 'xml'
        else:
            # Fallback to configured CONTENT_TYPE if no extension match
            detected_type = CONTENT_TYPE if CONTENT_TYPE != 'unknown' else None
        
        if not detected_type:
            logger.warning(f"  └─ ⚠️ Skipping file - cannot determine type for '{key}'")
            continue
        
        logger.info(f"  └─ Detected type: {detected_type}")
        
        # Parse based on detected content type
        try:
            if detected_type == 'csv':
                logger.info(f"  └─ Parsing as CSV")
                df = pd.read_csv(BytesIO(content))
                records = df.to_dict('records')
                logger.info(f"  └─ Extracted {len(records)} records from CSV")
                extracted_data.extend(records)
            elif detected_type == 'json':
                logger.info(f"  └─ Parsing as JSON")
                data = json.loads(content)
                if isinstance(data, list):
                    logger.info(f"  └─ Extracted {len(data)} records from JSON array")
                    extracted_data.extend(data)
                else:
                    logger.info(f"  └─ Extracted 1 record from JSON object")
                    extracted_data.append(data)
            elif detected_type == 'xml':
                logger.info(f"  └─ Parsing as XML")
                import xml.etree.ElementTree as ET
                root = ET.fromstring(content)
                records = []
                
                # Flatten nested XML structure to match metamodel
                def flatten_element(element, parent_path=''):
                    """Recursively flatten XML element to dict with nested paths."""
                    result = {}
                    
                    # Process current element's text
                    if element.text and element.text.strip():
                        # Only use parent_path if it's not empty, don't double-prefix
                        if parent_path:
                            result[parent_path.rstrip('_')] = element.text.strip()
                        else:
                            result[element.tag] = element.text.strip()
                    
                    # Process all child elements
                    for child in element:
                        # Build path with underscore separator for nested elements
                        if parent_path:
                            child_path = f"{parent_path}{child.tag}_"
                        else:
                            child_path = f"{child.tag}_"
                        child_data = flatten_element(child, child_path)
                        result.update(child_data)
                    
                    return result
                
                # Parse each record (direct children of root)
                # Don't include root element name in column paths
                for child in root:
                    row = flatten_element(child, '')
                    if row:  # Only add non-empty records
                        records.append(row)
                
                logger.info(f"  └─ Extracted {len(records)} records from XML")
                if records:
                    logger.info(f"  └─ Sample columns: {list(records[0].keys())}")
                extracted_data.extend(records)
            else:
                logger.warning(f"  └─ ⚠️ Skipping file - unsupported type '{detected_type}'")
                files_processed += 1
        except Exception as e:
            logger.error(f"  └─ ❌ Error parsing file '{key}' as {detected_type}: {e}")
            files_skipped += 1
            # Continue with next file instead of failing the whole task
            continue
    
    logger.info(f"Всего объектов найдено: {len(response.get('Contents', []))}")
    logger.info(f"Файлов обработано: {files_processed}")
    logger.info(f"Файлов пропущено: {files_skipped}")
    logger.info(f"Извлечено записей: {len(extracted_data)}")
    
    # Log sample of extracted data structure
    if extracted_data:
        logger.info(f"Пример структуры данных: {list(extracted_data[0].keys())}")
    
    return extracted_data


def extract_from_postgres():
    """Extract data from PostgreSQL."""
    import psycopg2
    from psycopg2.extras import RealDictCursor
    
    logger.info("📥 Извлечение из PostgreSQL")
    
    # DEBUG: Print full connection string (TEMPORARY - REMOVE IN PRODUCTION)
    logger.info("=" * 80)
    logger.info("🔍 DEBUG: POSTGRESQL EXTRACTION CREDENTIALS")
    logger.info(f"Connection String: {SOURCE_PATH}")
    logger.info(f"Source Table: {SOURCE_TABLE}")
    logger.info("=" * 80)
    
    conn = psycopg2.connect(SOURCE_PATH)
    cursor = conn.cursor(cursor_factory=RealDictCursor)
    
    # Build query - use SOURCE_TABLE from config if available
    if SOURCE_TABLE:
        query = os.getenv('SOURCE_QUERY', f"SELECT * FROM {SOURCE_TABLE}")
    else:
        query = os.getenv('SOURCE_QUERY', f"SELECT * FROM {os.getenv('SOURCE_TABLE', 'data')}")
    logger.info(f"Query: {query}")
    
    cursor.execute(query)
    
    # Fetch all data using configured batch size
    extracted_data = []
    while True:
        rows = cursor.fetchmany(BATCH_SIZE)
        if not rows:
            break
        extracted_data.extend([dict(row) for row in rows])
    
    logger.info(f"Извлечено записей: {len(extracted_data)}")
    
    cursor.close()
    conn.close()
    
    return extracted_data


def extract_from_clickhouse():
    """Extract data from ClickHouse."""
    from clickhouse_driver import Client
    
    logger.info("📥 Извлечение из ClickHouse")
    
    # DEBUG: Print full connection string (TEMPORARY - REMOVE IN PRODUCTION)
    logger.info("=" * 80)
    logger.info("🔍 DEBUG: CLICKHOUSE EXTRACTION CREDENTIALS")
    logger.info(f"Connection String: {SOURCE_PATH}")
    logger.info("=" * 80)
    
    # Parse connection string
    # Format: clickhouse://user:pass@host:port/database
    client = Client.from_url(SOURCE_PATH)
    
    # Build query
    query = os.getenv('SOURCE_QUERY', f"SELECT * FROM {os.getenv('SOURCE_TABLE', 'data')}")
    logger.info(f"Query: {query}")
    
    # Execute query
    result = client.execute(query, with_column_types=True)
    
    # Convert to dict format
    columns = [col[0] for col in result[1]]
    rows = result[0]
    
    extracted_data = [dict(zip(columns, row)) for row in rows]
    
    logger.info(f"Извлечено записей: {len(extracted_data)}")
    
    return extracted_data


def extract_from_folder():
    """Extract data from local folder."""
    logger.info("📥 Извлечение из локальной папки")
    logger.info(f"Path: {SOURCE_PATH}")
    
    source_path = Path(SOURCE_PATH)
    if not source_path.exists():
        raise FileNotFoundError(f"Source path not found: {SOURCE_PATH}")
    
    # Get specific files to process from config
    target_files = CONTENT_MESSAGES if CONTENT_MESSAGES else []
    logger.info(f"Target files from config: {target_files}")
    
    extracted_data = []
    files = list(source_path.glob(f"*.{CONTENT_TYPE}"))
    logger.info(f"Найдено файлов: {len(files)}")
    
    files_processed = 0
    files_skipped = 0
    
    for file_path in files:
        # If target files are specified, only process those
        if target_files:
            if file_path.name not in target_files:
                logger.debug(f"Skipping {file_path.name} - not in target files list")
                files_skipped += 1
                continue
        
        logger.info(f"Обработка файла: {file_path.name}")
