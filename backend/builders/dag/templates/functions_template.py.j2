    return extracted_data


def validate_extracted_data(data: list) -> dict:
    """Validate extracted data against quality thresholds."""
    validation_results = {
        "passed": True,
        "errors": [],
        "warnings": [],
        "metrics": {}
    }
    
    total_records = len(data)
    validation_results["metrics"]["total_records"] = total_records
    
    # Volume validation
    if total_records < DQ_VOLUME_MIN_RECORDS:
        validation_results["errors"].append(
            f"Volume below minimum: {total_records} < {DQ_VOLUME_MIN_RECORDS}"
        )
        validation_results["passed"] = False
    
    if DQ_VOLUME_MAX_RECORDS and total_records > DQ_VOLUME_MAX_RECORDS:
        validation_results["warnings"].append(
            f"Volume above maximum: {total_records} > {DQ_VOLUME_MAX_RECORDS}"
        )
    
    # Duplicate detection
    if DQ_DUPLICATE_DETECTION and data:
        import json
        unique_records = len(set(json.dumps(record, sort_keys=True) for record in data))
        duplicate_rate = (total_records - unique_records) / total_records if total_records > 0 else 0
        validation_results["metrics"]["duplicate_rate"] = duplicate_rate
        
        if duplicate_rate > DQ_DUPLICATE_THRESHOLD:
            validation_results["warnings"].append(
                f"Duplicate rate {duplicate_rate:.2%} exceeds threshold {DQ_DUPLICATE_THRESHOLD:.2%}"
            )
    
    # Completeness check
    if DQ_SCHEMA_VALIDATION and data:
        null_counts = {}
        for record in data:
            for key, value in record.items():
                if value is None:
                    null_counts[key] = null_counts.get(key, 0) + 1
        
        for field, null_count in null_counts.items():
            completeness = 1 - (null_count / total_records)
            if completeness < DQ_COMPLETENESS_THRESHOLD:
                validation_results["warnings"].append(
                    f"Field '{field}' completeness {completeness:.2%} below threshold {DQ_COMPLETENESS_THRESHOLD:.2%}"
                )
    
    return validation_results


def extract_data(**context):
    """
    Извлечение данных из источника.
    
    Source: {{ extract_config.source_metadata.source_type }}
    Connection: {{ extract_config.source_metadata.connection_string }}
    Batch Size: {{ extract_config.batch_size }}
    Resources: {{ extract_config.resources.cpu_request }} CPU, {{ extract_config.resources.memory_request_mb }}MB RAM
    """
    logger.info("📥 Начало извлечения данных")
    logger.info(f"Источник: {SOURCE_TYPE}")
    logger.info(f"Путь: {SOURCE_PATH}")
    logger.info(f"Batch size: {BATCH_SIZE}")
    logger.info(f"Content type: {CONTENT_TYPE}")
    logger.info(f"Max workers: {MAX_WORKERS}")
    logger.info(f"Retry count: {EXTRACT_RETRY_COUNT}")
    
    try:
        # Route to appropriate extraction function
        if SOURCE_TYPE == "s3":
            extracted_data = extract_from_s3()
        elif SOURCE_TYPE in ["postgres", "PostgreSQL"]:
            extracted_data = extract_from_postgres()
        elif SOURCE_TYPE in ["clickhouse", "ClickHouse"]:
            extracted_data = extract_from_clickhouse()
        elif SOURCE_TYPE == "folder":
            extracted_data = extract_from_folder()
        else:
            raise ValueError(f"Unsupported source type: {SOURCE_TYPE}")
        
        total_records = len(extracted_data)
        
        # Data quality validation
        logger.info("🔍 Проверка качества данных")
        validation_results = validate_extracted_data(extracted_data)
        
        for warning in validation_results["warnings"]:
            logger.warning(f"⚠️ {warning}")
        
        for error in validation_results["errors"]:
            logger.error(f"❌ {error}")
        
        if not validation_results["passed"]:
            raise ValueError(f"Data quality validation failed: {validation_results['errors']}")
        
        # Store extracted data in XCom
        result = {
            "total_records": total_records,
            "data": extracted_data,
            "source_type": SOURCE_TYPE,
            "content_type": CONTENT_TYPE,
            "timestamp": datetime.now().isoformat(),
            "validation": validation_results
        }
        
        logger.info(f"✅ Извлечение завершено: {total_records} записей")
        logger.info(f"📊 Метрики качества: {validation_results['metrics']}")
        return result
        
    except Exception as e:
        logger.error(f"❌ Ошибка извлечения данных: {e}", exc_info=True)
        raise

