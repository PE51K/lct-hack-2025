def load_data(**context):
    """
    Загрузка данных в целевое хранилище.
    
    Target: {{ load_config.target_storage_type.storage_type }}
    Database: {{ load_config.database_name }}
    Table: {{ load_config.table_name }}
    Strategy: {{ load_config.load_strategy }}
    """
    logger.info("📤 Начало загрузки данных")
    
    # Получение данных от предыдущей задачи
    ti = context['ti']
    transform_result = ti.xcom_pull(task_ids='transform_data')
    
    if not transform_result:
        raise ValueError("No data received from transform task")
    
    data = transform_result.get('data', [])
    logger.info(f"Получено записей для загрузки: {len(data)}")
    logger.info(f"Целевое хранилище: {TARGET_STORAGE_TYPE}")
    logger.info(f"База данных: {TARGET_DATABASE}")
    logger.info(f"Таблица: {TARGET_SCHEMA}.{TARGET_TABLE}")
    logger.info(f"Стратегия загрузки: {LOAD_STRATEGY}")
    
    if not data:
        logger.warning("No data to load")
        return {
            "loaded_records": 0,
            "target_table": f"{TARGET_SCHEMA}.{TARGET_TABLE}",
            "load_strategy": LOAD_STRATEGY,
            "timestamp": datetime.now().isoformat()
        }
    
    try:
        # Route to appropriate load function
        if TARGET_STORAGE_TYPE == "postgres":
            loaded_records = load_to_postgres(data)
        elif TARGET_STORAGE_TYPE == "clickhouse":
            loaded_records = load_to_clickhouse(data)
        else:
            raise ValueError(f"Unsupported target storage type: {TARGET_STORAGE_TYPE}")
        
        result = {
            "loaded_records": loaded_records,
            "target_table": f"{TARGET_SCHEMA}.{TARGET_TABLE}" if TARGET_STORAGE_TYPE == "postgres" else f"{TARGET_DATABASE}.{TARGET_TABLE}",
            "load_strategy": LOAD_STRATEGY,
            "timestamp": datetime.now().isoformat()
        }
        
        logger.info(f"✅ Загрузка завершена: {loaded_records} записей")
        return result
        
    except Exception as e:
        logger.error(f"❌ Ошибка загрузки данных: {e}", exc_info=True)
        raise

