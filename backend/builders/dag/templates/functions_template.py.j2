def apply_transformation_rule(data: List[Dict], rule: Dict) -> List[Dict]:
    """Apply a single transformation rule to data."""
    rule_type = rule.get('transformation_type', 'identity')
    rule_name = rule.get('rule_name', 'unknown')
    target_field = rule.get('target_field')
    expression = rule.get('expression', '')
    
    logger.info(f"Применение правила: {rule_name} (тип: {rule_type})")
    
    try:
        if rule_type == 'identity':
            # No transformation needed
            return data
            
        elif rule_type == 'rename':
            # Rename field
            old_name = rule.get('source_field')
            new_name = target_field
            for row in data:
                if old_name in row:
                    row[new_name] = row.pop(old_name)
                    
        elif rule_type == 'cast':
            # Cast to different type
            cast_type = rule.get('cast_to', 'str')
            for row in data:
                if target_field in row:
                    if cast_type == 'int':
                        row[target_field] = int(row[target_field])
                    elif cast_type == 'float':
                        row[target_field] = float(row[target_field])
                    elif cast_type == 'str':
                        row[target_field] = str(row[target_field])
                    elif cast_type == 'bool':
                        row[target_field] = bool(row[target_field])
                        
        elif rule_type == 'expression':
            # Evaluate expression
            for row in data:
                try:
                    # Simple eval - in production use safer alternative
                    row[target_field] = eval(expression, {"row": row, "pd": pd, "datetime": datetime})
                except Exception as e:
                    logger.warning(f"Expression eval failed for row: {e}")
                    row[target_field] = None
                    
        elif rule_type == 'default':
            # Set default value if missing
            default_value = rule.get('default_value')
            for row in data:
                if target_field not in row or row[target_field] is None:
                    row[target_field] = default_value
                    
        elif rule_type == 'filter':
            # Filter rows based on condition
            condition = expression
            filtered_data = []
            for row in data:
                try:
                    if eval(condition, {"row": row}):
                        filtered_data.append(row)
                except Exception as e:
                    logger.warning(f"Filter eval failed for row: {e}")
            return filtered_data
            
        elif rule_type == 'aggregate':
            # Group by and aggregate
            # This is simplified - real implementation would use pandas
            pass
            
        return data
        
    except Exception as e:
        logger.error(f"Error applying rule {rule_name}: {e}")
        raise


def transform_data(**context):
    """
    Трансформация извлеченных данных.
    
    Identity Keys: {{ transform_config.identity_keys | join(', ') }}
    Processing Mode: {{ transform_config.processing_mode }}
    Rules: {{ transform_config.transformation_rules | length }}
    """
    logger.info("🔄 Начало трансформации данных")
    
    # Получение данных от предыдущей задачи
    ti = context['ti']
    extract_result = ti.xcom_pull(task_ids='extract_data')
    
    if not extract_result:
        raise ValueError("No data received from extract task")
    
    data = extract_result.get('data', [])
    logger.info(f"Получено записей для обработки: {len(data)}")
    
    if not data:
        logger.warning("No data to transform")
        return {
            "transformed_records": 0,
            "data": [],
            "identity_keys": IDENTITY_KEYS,
            "processing_mode": PROCESSING_MODE,
            "timestamp": datetime.now().isoformat()
        }
    
    try:
        transformed_data = data.copy()
        
        # Apply transformation rules
        {% if transform_config.transformation_rules %}
        logger.info(f"Применение {len(TRANSFORMATION_RULES)} правил трансформации")
        for rule in TRANSFORMATION_RULES:
            transformed_data = apply_transformation_rule(transformed_data, rule)
            logger.info(f"После правила '{rule.get('rule_name')}': {len(transformed_data)} записей")
        {% else %}
        logger.info("Нет правил трансформации, передача данных как есть")
        {% endif %}
        
        # Data quality checks
        logger.info("Проверка качества данных")
        initial_count = len(transformed_data)
        
        # Remove null values if configured
        if PROCESSING_MODE == 'strict':
            transformed_data = [row for row in transformed_data if all(v is not None for v in row.values())]
            removed = initial_count - len(transformed_data)
            if removed > 0:
                logger.warning(f"Удалено {removed} записей с null значениями")
        
        # Add identity keys if needed
        # Only add if identity keys are defined and not already present
        if IDENTITY_KEYS:
            for i, row in enumerate(transformed_data):
                for key in IDENTITY_KEYS:
                    if key not in row:
                        # Generate a proper ID value, not concatenating key name
                        row[key] = i
                        logger.debug(f"Added identity key '{key}' with value {i} to row {i}")
        
        total_transformed = len(transformed_data)
        
        result = {
            "transformed_records": total_transformed,
            "data": transformed_data,
            "identity_keys": IDENTITY_KEYS,
            "processing_mode": PROCESSING_MODE,
            "timestamp": datetime.now().isoformat()
        }
        
        logger.info(f"✅ Трансформация завершена: {total_transformed} записей")
        return result
        
    except Exception as e:
        logger.error(f"❌ Ошибка трансформации данных: {e}", exc_info=True)
        raise

