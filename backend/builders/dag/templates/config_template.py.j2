        "sql_query": {% if rule.sql_query %}"{{ rule.sql_query }}"{% else %}None{% endif %},
        "python_function": {% if rule.python_function %}"{{ rule.python_function }}"{% else %}None{% endif %},
        "parameters": {{ rule.parameters }},
        "conditions": {% if rule.conditions %}"{{ rule.conditions }}"{% else %}None{% endif %},
        "priority": {{ rule.priority }},
        "enabled": {{ rule.enabled }},
        "error_handling": "{{ rule.error_handling }}",
    },
