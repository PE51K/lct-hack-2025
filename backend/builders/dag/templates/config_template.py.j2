# ============================================================================
# SOURCE CONFIGURATION
# ============================================================================

SOURCE_TYPE = "{{ extract_config.source_metadata.source_type }}"
SOURCE_PATH = "{{ extract_config.source_metadata.connection_string }}"
{% if extract_config.content_metadata and extract_config.content_metadata|length > 0 %}
CONTENT_TYPE = "{{ extract_config.content_metadata[0].content_type }}"
{% else %}
CONTENT_TYPE = "unknown"
{% endif %}

# Source-specific credentials
{% if extract_config.source_metadata.source_type == "s3" %}
S3_BUCKET = "{{ extract_config.source_metadata.bucket_name }}"
S3_ACCESS_KEY = "{{ extract_config.source_metadata.access_key }}"
S3_SECRET_KEY = "{{ extract_config.source_metadata.secret_key }}"
{% else %}
S3_BUCKET = None
S3_ACCESS_KEY = None
S3_SECRET_KEY = None
{% endif %}

{% if extract_config.source_metadata.source_type in ["PostgreSQL", "postgres"] %}
SOURCE_TABLE = "{{ extract_config.source_metadata.table_name }}"
{% else %}
SOURCE_TABLE = None
{% endif %}

# Content metadata
{% if extract_config.content_metadata and extract_config.content_metadata|length > 0 %}
CONTENT_MESSAGES = [
    {%- for content in extract_config.content_metadata %}
    "{{ content.message_name }}",
    {%- endfor %}
]
IS_COMPLEX_NESTING = {{ extract_config.content_metadata[0].is_complex_nesting_present }}
CONTENT_TYPES_MAP = {
    {%- for content in extract_config.content_metadata %}
    "{{ content.message_name }}": "{{ content.content_type }}",
    {%- endfor %}
}
{% else %}
CONTENT_MESSAGES = []
IS_COMPLEX_NESTING = False
CONTENT_TYPES_MAP = {}
{% endif %}

