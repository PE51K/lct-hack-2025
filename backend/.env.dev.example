# ==================== DOCKER PORT MAPPING ====================

# On which port forward the FastAPI app from the Docker container to the host machine
# Doesn't affect local development, only for docker deployment
APP_PORT=8000

# ==================== SHARED POSTGRES ====================

# Shared PostgreSQL container configuration
# This single PostgreSQL container hosts multiple databases for different services
# including LangGraph checkpointer, LangFuse
POSTGRES_VERSION=17
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_123
POSTGRES_HOST=localhost # `localhost` if running locally, or the service `postgres` if using within Docker Compose container network
POSTGRES_PORT=5432
POSTGRES_VOLUME=./volumes/postgres

# ==================== APP CORS ====================

# FastAPI CORS origins (comma-separated list)
APP_CORS_ORIGINS=["http://localhost", "http://localhost:5174"]
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_ALLOW_METHODS=["*"]
APP_CORS_ALLOW_HEADERS=["*"]

# ==================== LANGGRAPH CHECKPOINTER POSTGRES ====================

# Database for LangGraph memory persistence (hosted in the shared PostgreSQL container)
LANGGRAPH_CHECKPOINTER_POSTGRES_DB=langgraph_checkpointer

# ==================== YANDEX GPT ====================

# YandexGPT configuration for conversational AI and text generation
# Follow these steps to obtain your credentials:
#
# 1. Go to Yandex Cloud Console: https://console.yandex.cloud/
# 2. Create a new folder or select an existing one
# 3. Navigate to "Service Accounts" in the left sidebar
# 4. Create a new service account with "executor" role for foundation models
# 5. Go to the service account details and create an API key
# 6. Copy the API key and folder ID
#
# For detailed instructions, see:
# https://yandex.cloud/ru/docs/foundation-models/operations/get-api-key
#
# Required credentials:
YANDEX_GPT_API_KEY=your_api_key_here                    # Your Yandex Cloud API key
YANDEX_GPT_BASE_URL=https://llm.api.cloud.yandex.net/v1 # Yandex API endpoint (usually don't change)
YANDEX_GPT_FOLDER_ID=your_folder_id_here               # Your Yandex Cloud folder ID (from console)
YANDEX_GPT_MODEL=yandexgpt                         # Model name: yandexgpt-lite, yandexgpt
YANDEX_GPT_MODEL_VERSION=latest                         # Model version (latest, or specific version)

# ==================== LANGFUSE ====================

# Langfuse API credentials (get them in the Langfuse UI: Settings > Project Settings)
# After the first docker-compose launch, go to http://localhost:3000
# and create a project, then copy the keys here
# IMPORTANT: Replace these values with real keys from the Langfuse UI!
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=localhost # `localhost` if running locally, or the service `langfuse-web` if using within Docker Compose container network
LANGFUSE_PORT=3000
LANGFUSE_ENABLED=true

# Langfuse database configuration (another database in the shared PostgreSQL container)
LANGFUSE_POSTGRES_DB=langfuse

# Langfuse encryption and auth (IMPORTANT: generate unique values for production)
# Use: openssl rand -hex 32 for LANGFUSE_ENCRYPTION_KEY
LANGFUSE_SALT=random_salt_value_123
LANGFUSE_ENCRYPTION_KEY=super_secret_encryption_key_123
NEXTAUTH_SECRET=super_secret_nextauth_key_123

# Langfuse ClickHouse configuration
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=secure_clickhouse_password_123
CLICKHOUSE_DATA_VOLUME=./volumes/clickhouse/data
CLICKHOUSE_LOGS_VOLUME=./volumes/clickhouse/logs

# Langfuse S3/MinIO configuration
LANGFUSE_S3_ACCESS_KEY_ID=minio
LANGFUSE_S3_SECRET_ACCESS_KEY=secure_minio_password_123
LANGFUSE_S3_VOLUME=./volumes/minio

# Langfuse Redis configuration
REDIS_AUTH=secure_redis_password_123
REDIS_VOLUME=./volumes/redis

# Langfuse optional init configuration (for automatic setup on first launch)
# On some versions of Langfuse, these setup is broken, so instead I would recommend setting them manually from the UI
# LANGFUSE_INIT_ORG_NAME=MyOrganization
# LANGFUSE_INIT_PROJECT_NAME=MyProject
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=admin123
