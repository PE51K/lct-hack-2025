# ==================== TEST DATABASES ====================

# Clickhouse
# Use: openssl rand -hex 32 for TEST_CLICKHOUSE_PASSWORD
TEST_CLICKHOUSE_USER=test_clickhouse
TEST_CLICKHOUSE_PASSWORD=securepassword1234567890abcdef
