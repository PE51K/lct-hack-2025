TEST_CLICKHOUSE_HTTP_PORT=8124
TEST_CLICKHOUSE_NATIVE_PORT=9001
TEST_CLICKHOUSE_LOGS_VOLUME=./volumes/test_clickhouse/logs

# PostgreSQL
TEST_POSTGRES_USER=test_postgres
TEST_POSTGRES_PASSWORD=securepassword1234567890abcdef
